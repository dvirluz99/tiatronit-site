rules_version = '2';

// Firestore security rules — deployed to project "teatronit-db".
// Source of truth lives in this file; deploy with:
//   npx firebase-tools deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // Allowlist of admin UIDs. Add a new UID here when granting write access.
    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        'vpsUQFeSx9d4ncb1Oeduy9KfD2j2', // ronitluz@gmail.com (רונית)
        'FqZ6ZSjCpVeOZPlGyx99HyCSJsk2'  // dvirluz99@gmail.com (דביר)
      ];
    }

    match /{document=**} {
      // Public site reads — required for the public-facing pages.
      allow read: if true;
      // Only admins can mutate.
      allow write: if isAdmin();
    }
  }
}
